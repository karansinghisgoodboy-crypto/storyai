# Copy this file to ".env". Replace placeholders on your machine only.
# Never put a real API key in this file or share/commit your local ".env".

# AI provider settings. Ollama is local and does not require OpenAI credits.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional local overrides; these are the names config.py reads.
# HOST=127.0.0.1
# PORT=5000
# DATABASE_PATH=db/storyai.db
# UPLOAD_DIR=uploads
